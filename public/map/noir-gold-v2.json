{
  "version": 8,
  "name": "OnlyMen Noir Gold v2",
  "metadata": {
    "onlymen:variant": "noir-gold-v2",
    "onlymen:notes": "Noir Gold with slightly higher road and label contrast, major road names, and a lighter area-circle fill so streets stay readable. Mood stays dark."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#050505"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#0B0C0A",
        "fill-opacity": 0.55,
        "fill-antialias": true
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#0A0908",
        "fill-opacity": 0.4,
        "fill-antialias": true
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#0C0D0A",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#151821",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.6,
          14,
          1.8
        ],
        "line-opacity": 0.85
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0C0E13",
        "fill-antialias": true,
        "fill-opacity": 1
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#1A1A1A",
        "fill-opacity": 0.8,
        "fill-outline-color": "#242424"
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "admin_level"
          ],
          4
        ],
        [
          "!=",
          [
            "get",
            "maritime"
          ],
          1
        ]
      ],
      "paint": {
        "line-color": "#D4AF37",
        "line-width": 0.8,
        "line-opacity": 0.18,
        "line-dasharray": [
          3,
          3
        ]
      }
    },
    {
      "id": "roads-tunnel",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ],
        [
          "==",
          [
            "get",
            "brunnel"
          ],
          "tunnel"
        ],
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary",
            "minor",
            "service"
          ],
          true,
          false
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D4AF37",
        "line-opacity": 0.22,
        "line-dasharray": [
          1.5,
          1.2
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          [
            "match",
            [
              "get",
              "class"
            ],
            "motorway",
            1.6,
            "trunk",
            1.4,
            "primary",
            1.1,
            "secondary",
            0.8,
            "tertiary",
            0.55,
            0.35
          ],
          14,
          [
            "match",
            [
              "get",
              "class"
            ],
            "motorway",
            2.8,
            "trunk",
            2.4,
            "primary",
            1.8,
            "secondary",
            1.2,
            "tertiary",
            0.8,
            0.5
          ]
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ],
        [
          "!=",
          [
            "get",
            "brunnel"
          ],
          "tunnel"
        ],
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary",
            "minor",
            "service"
          ],
          true,
          false
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          "motorway",
          "#E0C056",
          "trunk",
          "#E0C056",
          "primary",
          "#DCB84A",
          "#D4AF37"
        ],
        "line-opacity": [
          "match",
          [
            "get",
            "class"
          ],
          "motorway",
          0.52,
          "trunk",
          0.5,
          "primary",
          0.42,
          "secondary",
          0.36,
          "tertiary",
          0.3,
          "minor",
          0.26,
          0.2
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          [
            "match",
            [
              "get",
              "class"
            ],
            "motorway",
            2.2,
            "trunk",
            2.0,
            "primary",
            1.5,
            "secondary",
            1.05,
            "tertiary",
            0.7,
            "minor",
            0.5,
            0.35
          ],
          14,
          [
            "match",
            [
              "get",
              "class"
            ],
            "motorway",
            3.8,
            "trunk",
            3.2,
            "primary",
            2.4,
            "secondary",
            1.7,
            "tertiary",
            1.15,
            "minor",
            0.85,
            0.5
          ]
        ]
      }
    },
    {
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "ref"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-max-angle": 25,
        "text-optional": true,
        "text-padding": 2,
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          11.5,
          14,
          13.5
        ],
        "text-letter-spacing": 0.06,
        "symbol-spacing": 140
      },
      "paint": {
        "text-color": "#E8D5A3",
        "text-halo-color": "#050505",
        "text-halo-blur": 0.35,
        "text-opacity": 0.88,
        "text-halo-width": 2.0
      },
      "id": "road-name-major",
      "minzoom": 11,
      "filter": [
        "all",
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk",
            "primary"
          ],
          true,
          false
        ],
        [
          "!=",
          [
            "get",
            "subclass"
          ],
          "junction"
        ]
      ]
    },
    {
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-max-angle": 35,
        "text-optional": true,
        "text-padding": 2,
        "text-size": 12,
        "text-letter-spacing": 0.03,
        "symbol-spacing": 160
      },
      "paint": {
        "text-color": "#E8D5A3",
        "text-halo-color": "#050505",
        "text-halo-blur": 0.35,
        "text-opacity": 0.84,
        "text-halo-width": 1.9
      },
      "id": "road-name-street",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "match",
          [
            "get",
            "class"
          ],
          [
            "secondary",
            "tertiary",
            "minor"
          ],
          true,
          false
        ],
        [
          "has",
          "name"
        ]
      ]
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 11,
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-letter-spacing": 0.12,
        "text-max-angle": 30,
        "text-optional": true
      },
      "paint": {
        "text-color": "#E8D5A3",
        "text-opacity": 0.62,
        "text-halo-color": "#050505",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "city",
          "town"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          13,
          14,
          18
        ],
        "text-letter-spacing": 0.12,
        "text-transform": "uppercase",
        "text-optional": true,
        "text-padding": 8,
        "symbol-sort-key": [
          "get",
          "rank"
        ]
      },
      "paint": {
        "text-color": "#F3E6C0",
        "text-opacity": 0.94,
        "text-halo-color": "#000000",
        "text-halo-width": 2.6,
        "text-halo-blur": 0.7
      }
    },
    {
      "id": "place-suburb",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 11,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "suburb",
          "neighbourhood",
          "quarter",
          "village",
          "hamlet"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12.5,
        "text-letter-spacing": 0.04,
        "text-optional": true,
        "text-padding": 2,
        "symbol-sort-key": [
          "get",
          "rank"
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#E8D5A3",
        "text-opacity": 0.82,
        "text-halo-color": "#050505",
        "text-halo-width": 1.8,
        "text-halo-blur": 0.4
      }
    }
  ]
}

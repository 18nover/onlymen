# Unlike local dev (POSTGRES_HOST_AUTH_METHOD=trust, no password), production
# requires a real password. Generate independently of every other secret in
# this directory and paste the same value into every *_DB_POSTGRES_URL
# connection string in bsky.env, ozone.env, and bsync.env.
POSTGRES_USER=onlymen
POSTGRES_PASSWORD=replace-with-a-high-entropy-password
POSTGRES_DB=bsky

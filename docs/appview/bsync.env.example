# See atproto/packages/bsync/src/config.ts for the full var list this was
# derived from.

BSYNC_PORT=3000

# Shares the bsky database (own tables, not a separate database) - same
# default the local dev docker-compose.yml uses.
BSYNC_DB_POSTGRES_URL=postgresql://onlymen:replace-with-a-high-entropy-password@postgres:5432/bsky
BSYNC_DB_MIGRATE=1

# Comma-separated; at least one required. Any key in this list must also
# appear as BSKY_BSYNC_API_KEY in bsky.env.
BSYNC_API_KEYS=replace-with-a-high-entropy-shared-secret

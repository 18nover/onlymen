# Public service identity
PDS_HOSTNAME=pds.onlymen.gay
PDS_PORT=3000
PDS_SERVICE_NAME=OnlyMen PDS
PDS_SERVICE_HANDLE_DOMAINS=.pds.onlymen.gay

# Generate each value independently. Never commit the real values.
PDS_JWT_SECRET=replace-with-32-random-bytes-as-hex
PDS_DPOP_SECRET=replace-with-32-random-bytes-as-hex
PDS_ADMIN_PASSWORD=replace-with-a-high-entropy-password
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=replace-with-a-64-character-k256-private-key

# Persistent container paths
PDS_DATA_DIRECTORY=/app/data
PDS_BLOBSTORE_DISK_LOCATION=/app/data/blocks
PDS_BLOB_UPLOAD_LIMIT=104857600

# Identity and OnlyMen services
PDS_DID_PLC_URL=https://plc.directory
# Intended OnlyMen service names. Do not deploy until each URL is live and
# each DID is the real DID published by that service.
PDS_BSKY_APP_VIEW_URL=https://api.onlymen.gay
PDS_BSKY_APP_VIEW_DID=did:web:api.onlymen.gay
PDS_MOD_SERVICE_URL=https://mod.onlymen.gay
PDS_MOD_SERVICE_DID=did:plc:replace-with-ozone-did
PDS_REPORT_SERVICE_URL=https://mod.onlymen.gay
PDS_REPORT_SERVICE_DID=did:plc:replace-with-ozone-did

# Only set this after the target implements com.atproto.sync.requestCrawl.
# PDS_CRAWLERS=https://relay.onlymen.gay

# Production policy
PDS_INVITE_REQUIRED=true
PDS_RATE_LIMITS_ENABLED=true
PDS_DISABLE_SSRF_PROTECTION=false
LOG_ENABLED=true
LOG_LEVEL=info

# Configure both SMTP values before onboarding real users.
# Percent-encode special characters in the SMTP URL credentials.
PDS_EMAIL_SMTP_URL=smtps://user:password@your-smtp-provider:465/
PDS_EMAIL_FROM_ADDRESS=accounts@onlymen.gay
PDS_CONTACT_EMAIL_ADDRESS=admin@onlymen.gay

# Shared by both the `bsky` (public API) and `bsky-indexer` (dataplane +
# firehose subscription) containers - they are one logical service split
# into two processes. See atproto/services/bsky/README.md and
# atproto/services/bsky-indexer/README.md for the full var lists this was
# derived from.

NODE_ENV=production
BSKY_PUBLIC_URL=https://api.onlymen.gay
BSKY_PORT=3000

# Public service identity - a static did:web identity (no repo), unlike
# Ozone's account-backed did:plc. Caddy/the api server serve the matching
# did:web document at https://api.onlymen.gay/.well-known/did.json.
BSKY_SERVER_DID=did:web:api.onlymen.gay

# secp256k1 private key hex, same format as PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX.
# Generate independently from every other key in this file:
#   openssl ecparam --name secp256k1 --genkey --noout --outform DER \
#     | tail --bytes=+8 | head --bytes=32 | xxd --plain --cols 32
BSKY_SERVICE_SIGNING_KEY=replace-with-a-64-character-k256-private-key

BSKY_ADMIN_PASSWORDS=replace-with-a-high-entropy-password

BSKY_DID_PLC_URL=https://plc.directory

# Points at bsky-indexer's dataplane RPC port on the shared internal network.
BSKY_DATAPLANE_URLS=http://bsky-indexer:3000

BSKY_BSYNC_URL=http://bsync:3000
# Must equal one of the keys in bsync.env's BSYNC_API_KEYS.
BSKY_BSYNC_API_KEY=replace-with-a-high-entropy-shared-secret

# Ozone's real did:plc, created via deploy/pds/create-account.sh - see
# deploy/appview/README.md's identity bootstrap order. Must match
# OZONE_SERVER_DID in ozone.env and PDS_MOD_SERVICE_DID in deploy/pds/pds.env.
MOD_SERVICE_DID=did:plc:replace-with-ozone-did

# --- bsky-indexer only (harmless but unused by the `bsky` api container) ---

# Postgres database this AppView owns exclusively (not shared with Ozone).
BSKY_DB_POSTGRES_URL=postgresql://onlymen:replace-with-a-high-entropy-password@postgres:5432/bsky
BSKY_DB_POOL_SIZE=10
# Only the deploying release should run migrations; leave "1" here since
# deploy.sh recreates both containers together on every deploy.
BSKY_DB_MIGRATE=1
BSKY_DATAPLANE_PORT=3000

# The firehose source to index. No relay/BGS package exists in this fork, so
# a small deployment subscribes to its one PDS directly rather than a relay.
BSKY_REPO_PROVIDER=https://pds.onlymen.gay

# --- Age assurance (18+) - required before public launch ---
#
# OnlyMen is an adult platform; nothing else in this stack verifies age
# (PDS_INVITE_REQUIRED gates invites, not age). The AppView ships upstream
# Bluesky's full Kids Web Services (Epic Games KWS) age-assurance
# integration - atproto/packages/bsky/src/api/age-assurance/ on the server,
# app/src/ageAssurance/ in the client - but it stays dormant until the
# BSKY_KWS_* variables are set: with them unset, age-assurance state is
# served as unknown and nothing is gated.
#
# Obtain credentials from Kids Web Services (https://www.kidswebservices.com)
# or swap in another provider behind the same variables. config.ts
# (atproto/packages/bsky/src/config.ts) requires all ten to be set together
# and fails at boot on a partial set. The webhook and redirect handlers are
# served by this AppView at
#   https://api.onlymen.gay/age-assurance/webhooks/kws-age-verified
#   https://api.onlymen.gay/age-assurance/redirects/kws-age-verified
#
#BSKY_KWS_API_KEY=
#BSKY_KWS_API_ORIGIN=
#BSKY_KWS_AUTH_ORIGIN=
#BSKY_KWS_CLIENT_ID=
#BSKY_KWS_REDIRECT_URL=https://api.onlymen.gay/age-assurance/redirects/kws-age-verified
#BSKY_KWS_USER_AGENT=onlymen-appview
#BSKY_KWS_VERIFICATION_SECRET=
#BSKY_KWS_WEBHOOK_SECRET=
#BSKY_KWS_AGE_VERIFIED_WEBHOOK_SECRET=
#BSKY_KWS_AGE_VERIFIED_REDIRECT_SECRET=

# See atproto/packages/ozone/src/config/env.ts for the full var list this
# was derived from.

NODE_ENV=production
OZONE_PORT=3000
OZONE_PUBLIC_URL=https://mod.onlymen.gay

# Ozone's own service identity. Unlike bsky's static did:web, this must be a
# real account-backed did:plc - Ozone publishes moderation actions/labels as
# its own repo. Create it on the already-live production PDS first:
#   deploy/pds/create-account.sh moderator@onlymen.gay mod.pds.onlymen.gay
# then paste the DID it prints below. Must match MOD_SERVICE_DID in
# bsky.env and PDS_MOD_SERVICE_DID / PDS_REPORT_SERVICE_DID in
# deploy/pds/pds.env. See deploy/appview/README.md's identity bootstrap order.
OZONE_SERVER_DID=did:plc:replace-with-ozone-did

# Which human-controlled account DIDs can administer Ozone's own console -
# NOT the same thing as OZONE_SERVER_DID above. Typically your own personal
# OnlyMen account DID, created the normal way through the app/PDS.
OZONE_ADMIN_DIDS=did:plc:replace-with-your-own-moderator-account-did

OZONE_APPVIEW_URL=https://api.onlymen.gay
OZONE_APPVIEW_DID=did:web:api.onlymen.gay
OZONE_PDS_URL=https://pds.onlymen.gay
# The production PDS's own service DID (see deploy/pds/README.md /
# https://pds.onlymen.gay/.well-known/did.json once deployed).
OZONE_PDS_DID=did:web:pds.onlymen.gay

OZONE_DID_PLC_URL=https://plc.directory

# Separate database from bsky's, on the same shared Postgres instance -
# created automatically by init-postgres-databases.sh.
OZONE_DB_POSTGRES_URL=postgresql://onlymen:replace-with-a-high-entropy-password@postgres:5432/ozone

# Generate each secret independently, same as pds.env. Never commit real values.
OZONE_ADMIN_PASSWORD=replace-with-a-high-entropy-password
# secp256k1 private key hex - generate the same way as BSKY_SERVICE_SIGNING_KEY:
#   openssl ecparam --name secp256k1 --genkey --noout --outform DER \
#     | tail --bytes=+8 | head --bytes=32 | xxd --plain --cols 32
OZONE_SIGNING_KEY_HEX=replace-with-a-64-character-k256-private-key

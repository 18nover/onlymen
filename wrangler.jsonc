{
  "$schema": "node_modules/wrangler/config-schema.json",
  // OnlyMen on Cloudflare Workers — workers.dev PREVIEW ONLY.
  // No routes, no custom domains, no DNS. onlymen.gay / onlymen.live stay on Vercel.
  // Build with `npm run build:cf` (DEPLOY_TARGET=cloudflare), then `npx wrangler deploy`.
  "name": "onlymen",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-21",
  // Already implied by a compatibility_date >= 2026-08-04; kept explicit on purpose.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  },
  // Hyperdrive config "onlymen-neon" (account 18nover) → Neon direct host, db onlymen,
  // user onlymen_owner. The Worker needs no other database secret.
  // For `wrangler dev`, set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
  // (or localConnectionString below — never commit a real one).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "2e620b8e625e454fb58fc8120df9e02f"
    }
  ],
  // Non-secret runtime vars. Secrets (BETTER_AUTH_SECRET, ONLYMEN_ALLOWED_USER_IDS,
  // webhook URL/key, …) go in with `wrangler secret put` — see docs/HOSTING.md.
  "vars": {
    "NODE_ENV": "production",
    // Invite-code sign-up (src/lib/invites). Vercel leaves this unset → owner-only private mode.
    "ONLYMEN_INVITES": "on",
    // Default on: invented demo profiles stay in the directory, with real
    // eligible accounts (today: role=owner) replacing them one-for-one.
    // Set to "off" to hide every placeholder once you want a real-only grid.
    "ONLYMEN_DEMO_PROFILES": "on",
    // 18+ visitor age gate (server/middleware/age-gate.ts, docs/AGE_GATE.md).
    "ONLYMEN_AGE_GATE": "on",
    // Which AgeVerifier passes visitors. "clickthrough" = DEV/TEST ONLY — NOT
    // legal age verification under KRS 436.001 (Kentucky) or similar laws.
    // A real vendor ("vendor" stub today) is needed before going public.
    "ONLYMEN_AGE_VERIFIER": "clickthrough",
    // Block visitors geolocated to U.S. states with adult-site AV laws
    // (src/lib/age-gate/av-states.ts). OFF: Jerry is in Kentucky. Owner/admin bypass.
    "ONLYMEN_AGE_GATE_GEOBLOCK": "off",
    // Creator ID verification + 2257 (src/lib/verification, docs/VERIFICATION.md).
    // On: only APPROVED creators can go live or mark photos explicit.
    "ONLYMEN_ID_VERIFICATION": "on",
    // KYC provider: "manual" (admin review at /admin/verifications). Vendors plug in here.
    "ONLYMEN_KYC_PROVIDER": "manual",
    // "on" lets an admin approve their OWN verification (solo operator).
    // Self-reviews are tagged "self-review" in the audit log.
    "ONLYMEN_KYC_SELF_REVIEW": "on"
  }
  // Private R2 bucket for ID documents — add once R2 is enabled on the account
  // (Cloudflare dashboard → R2; free tier 10 GB-month). Until then files are
  // stored AES-256-GCM encrypted in Neon (om_verification_blob).
  // "r2_buckets": [{ "binding": "KYC_BUCKET", "bucket_name": "onlymen-kyc" }]
}
